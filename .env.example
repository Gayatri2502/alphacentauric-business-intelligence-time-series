# Optional values. Docker Compose reads a root .env file automatically.
# Native Python launch does NOT read .env; export variables or use --port/--host.
BI_PORT=8000
# Docker service fixes its internal bind address to 0.0.0.0; host port remains loopback.
# Native default is 127.0.0.1.
BI_BIND_HOST=127.0.0.1
# Native optional absolute path; Docker service uses /app/var with a named volume.
# BI_DATA_DIR=/absolute/path/to/my-bi-data
